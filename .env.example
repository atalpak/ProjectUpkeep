# ---------------------------------------------------------------------------
# Supabase — from your project's API settings page.
# ---------------------------------------------------------------------------

# Safe to expose to the browser. Used by the client and by server components
# acting on behalf of the signed-in user (RLS applies).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# SERVER ONLY. Bypasses RLS. Used exclusively by the Scryfall sync job, which
# writes to `cards` — a table no end user is allowed to write to.
# Never import this into anything under src/app.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# Signup
# ---------------------------------------------------------------------------

# Set to require an invite code to create an account. Leave unset to keep
# signup open. Server only — never exposed to the browser.
SIGNUP_INVITE_CODE=""

# ---------------------------------------------------------------------------
# Scryfall sync (optional overrides)
# ---------------------------------------------------------------------------

# Which Scryfall bulk dataset to pull. `default_cards` is one row per printing
# in the user's preferred language, which is what our `cards` table models.
SCRYFALL_BULK_TYPE="default_cards"

# Rows per upsert round-trip. Lower this if you hit statement timeouts on the
# Supabase free tier.
SCRYFALL_BATCH_SIZE="500"

# Contact string sent in the User-Agent, as Scryfall's API guidelines request.
SCRYFALL_CONTACT="project-upkeep (contact@example.com)"

# ---------------------------------------------------------------------------
# Oracle loader (scripts/sync-oracle-direct.ts) -- leave unset unless you are
# running `npm run sync:oracle` yourself
# ---------------------------------------------------------------------------

# Session-pooler connection string for the least-privilege scryfall_loader role
# (migration 44): port 5432, user `scryfall_loader.<project-ref>`. Not the
# IPv6-only db.<ref>.supabase.co host, and not port 6543. As powerful as that
# role: read by scripts/ only, never by anything under src/, apps/ or packages/.
# SCRYFALL_SYNC_DATABASE_URL="postgresql://scryfall_loader.<ref>:<password>@<pooler-host>:5432/postgres"

# PEM of the CA the pooler's certificate chains to, if Node does not already
# trust it. TLS is always verified; there is no way to turn that off.
# SCRYFALL_SYNC_DATABASE_CA=

# ---------------------------------------------------------------------------
# Catalog search (Scryfall API) — optional. No API key exists or is needed.
# ---------------------------------------------------------------------------

# Contact put in the User-Agent Scryfall requires, e.g. an email or site URL.
# SCRYFALL_SEARCH_CONTACT="you@example.com"

# Set to "false" to switch /search back to the older local search (rollback).
# Migration 48 (the shared traffic gate) must be applied before enabling.
# SCRYFALL_SEARCH_ENABLED="true"
