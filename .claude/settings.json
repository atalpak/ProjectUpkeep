{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Bash(npx supabase db reset:*)",
      "Bash(npx --yes supabase db reset:*)",
      "Bash(supabase db reset:*)",
      "Bash(npm run db:reset:*)",
      "Bash(npx supabase projects delete:*)",
      "Bash(npx --yes supabase projects delete:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",

      "Bash(rm -rf:*)",

      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",

      "Edit(./archive/**)",
      "Write(./archive/**)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)"
    ]
  }
}
