# Copy to .env. Only PUBLIC credentials belong in EXPO_PUBLIC values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Versioned catalog: scripts/export-catalog.ts -> `npm run catalog:build -w
# @upkeep/scan-core` -> scripts/publish-catalog.ts (repo root). The publish
# step prints the real HTTPS URL to use here -- it looks like
# https://YOUR_PROJECT.supabase.co/storage/v1/object/public/catalog/v1/catalog-<hash>.json,
# not a path you choose by hand.
EXPO_PUBLIC_CATALOG_URL=https://YOUR_HOST/catalog-v1.json
