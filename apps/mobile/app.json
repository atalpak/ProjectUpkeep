{
  "expo": {
    "name": "Project Upkeep",
    "slug": "upkeep-scan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.projectupkeep.scanner",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.projectupkeep.scanner"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Upkeep to scan your Magic cards.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ]
  }
}
