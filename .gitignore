# dependencies
node_modules/
.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# env
.env
.env.local
.env*.local

# mobile workspace (apps/mobile) — native projects are regenerated by Expo
# prebuild, not hand-edited, so they don't belong in version control.
# (*.tsbuildinfo is already covered above; .env/.env*.local are too, since a
# leading-slash-free pattern matches at any depth — .env.example is kept
# tracked explicitly, matching the pattern MTGCardScanner's own .gitignore used.)
.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/dist/
apps/mobile/.env.*
!apps/mobile/.env.example

# supabase local dev
supabase/.branches
supabase/.temp
supabase/.env

# throwaway local Postgres data dir used for `npm run test:db` runs
.pgtmp/

# scryfall sync working files
/.cache/
/tmp/

# misc
.DS_Store
*.pem
.vercel

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Personal permission rules (Supabase pushes with your credentials)
.claude/settings.local.json
